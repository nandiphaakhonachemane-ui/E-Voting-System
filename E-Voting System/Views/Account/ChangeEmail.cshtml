@{
    ViewData["Title"] = "Change Email";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold mb-1">Change Email</h2>
                    <p class="text-muted mb-0">This will become your new login address.</p>
                </div>

                <form asp-action="ChangeEmail" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">New Email</label>
                        <input name="newEmail" type="email" class="form-control" placeholder="correct@email.com" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Current Password</label>
                        <input name="currentPassword" type="password" class="form-control" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Update Email</button>
                </form>
            </div>
        </div>
    </div>
</div>