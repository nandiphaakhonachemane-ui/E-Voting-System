@{
    ViewData["Title"] = "Admin Panel";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">Admin Panel</h1>
    <p class="text-muted mb-0">Manage voters, parties, and elections.</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column p-4">
                <h5 class="fw-bold">Voter Approvals</h5>
                <p class="text-muted">Review registered voters before they can cast a vote.</p>
                <a class="btn btn-primary mt-auto" asp-controller="Admin" asp-action="PendingVoters">Pending Voters</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column p-4">
                <h5 class="fw-bold">Political Parties</h5>
                <p class="text-muted">Add, edit, or view registered political parties.</p>
                <a class="btn btn-primary mt-auto" asp-controller="Admin" asp-action="Parties">Manage Parties</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column p-4">
                <h5 class="fw-bold">Elections</h5>
                <p class="text-muted">Create and manage national or provincial elections.</p>
                <a class="btn btn-primary mt-auto" asp-controller="Admin" asp-action="Elections">Manage Elections</a>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Back to Home</a>
</div>
