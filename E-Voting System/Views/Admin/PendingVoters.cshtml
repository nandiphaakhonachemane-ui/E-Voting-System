@model List<E_Voting_System.Models.ApplicationUser>
@using E_Voting_System.Helpers

@{
    ViewData["Title"] = "Pending Voter Approvals";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Pending Voter Approvals</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Admin Panel</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            There are currently no pending voters waiting for approval.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>SA ID Number</th>
                        <th>Registered</th>
                        <th style="width: 140px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@IdMasker.Mask(user.SouthAfricanId)</td>   <!-- Masked -->
                            <td>@user.RegisteredAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <form asp-action="ApproveVoter" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-success btn-sm"
                                            onclick="return confirm('Approve this voter?');">
                                        Approve
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>