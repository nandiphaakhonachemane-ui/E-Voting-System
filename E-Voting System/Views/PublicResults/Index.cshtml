@model IEnumerable<E_Voting_System.Models.Election>
@{
    ViewData["Title"] = "Election Results";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="fw-bold mb-1">Election Results</h1>
        <p class="text-muted mb-0">Published results for completed elections.</p>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-light border">No published results yet.</div>
}
else
{
    <div class="row">
        @foreach (var election in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-success align-self-start mb-3">Results Published</span>
                        <h5 class="card-title fw-bold">@election.Name</h5>
                        <p class="text-muted mb-4">
                            @election.StartDate.ToString("dd MMM yyyy") – @election.EndDate.ToString("dd MMM yyyy")
                        </p>
                        <a class="btn btn-primary mt-auto"
                           asp-action="Details"
                           asp-route-id="@election.Id">View Results</a>
                    </div>
                </div>
            </div>
        }
    </div>
}