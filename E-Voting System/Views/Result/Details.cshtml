@model E_Voting_System.ViewModels.ElectionResultsViewModel
@{
    ViewData["Title"] = "Admin Results - " + Model.Election.Name;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">@Model.Election.Name</h1>
            <p class="text-muted mb-0">
                @Model.Election.StartDate.ToString("dd MMM yyyy") – @Model.Election.EndDate.ToString("dd MMM yyyy")
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary me-2">← Back</a>

            @if (!Model.Election.ResultsPublished)
            {
                <form asp-action="PublishResults" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Election.Id" />
                    <button type="submit" class="btn btn-success"
                            onclick="return confirm('Are you sure you want to publish these results? This will make them visible to the public.');">
                        Publish Results
                    </button>
                </form>
            }
            else
            {
                <span class="badge bg-primary fs-6">Results Published</span>
            }
        </div>
    </div>

    <!-- Summary -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center border-primary">
                <div class="card-body">
                    <h3 class="text-primary">@Model.TotalNationalVotes.ToString("N0")</h3>
                    <p class="mb-0">Total National Votes</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center border-success">
                <div class="card-body">
                    <h3 class="text-success">@Model.NationalResults.Count</h3>
                    <p class="mb-0">Parties</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center border-info">
                <div class="card-body">
                    <h3 class="text-info">
                        @(Model.NationalResults.Any() ? Model.NationalResults.First().PartyCode : "-")
                    </h3>
                    <p class="mb-0">Leading Party</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">National Results</h5>
            <a asp-action="ExportCsv" asp-route-id="@Model.Election.Id" class="btn btn-sm btn-light">
                Export CSV
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Party</th>
                            <th>Code</th>
                            <th class="text-end">Votes</th>
                            <th class="text-end">Percentage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rank = 1;
                        }
                        @foreach (var result in Model.NationalResults)
                        {
                            double percentage = Model.TotalNationalVotes > 0
                                ? (double)result.Votes / Model.TotalNationalVotes * 100
                                : 0;
                            <tr>
                                <td>@rank</td>
                                <td><strong>@result.PartyName</strong></td>
                                <td><span class="badge bg-secondary">@result.PartyCode</span></td>
                                <td class="text-end">@result.Votes.ToString("N0")</td>
                                <td class="text-end">@percentage.ToString("0.00")%</td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
