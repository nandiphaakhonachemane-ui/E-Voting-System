@{
    ViewData["Title"] = "Not Eligible to Vote";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 text-center">
            <div class="card-body p-5">
                <div class="mb-3" style="font-size: 3rem; color: #dc3545;">!</div>
                <h1 class="h3 fw-bold text-danger mb-2">You are not eligible to vote</h1>
                <p class="text-muted mb-1">Your account has not been approved as an eligible voter yet.</p>
                <p class="text-muted mb-4">Please contact an Election Officer or Administrator to get approved.</p>

                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to Home</a>
            </div>
        </div>
    </div>
</div>