@{
    ViewData["Title"] = "Verify OTP";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow">
        <div class="card-body">
            <h3 class="text-center mb-4">Two-Factor Verification</h3>
            <p class="text-muted text-center">
                We have sent a 6-digit code to your email.<br />
                Please enter it below to continue voting.
            </p>

            <form asp-action="VerifyOtp" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">OTP Code</label>
                    <input type="text" name="code" class="form-control form-control-lg text-center"
                           maxlength="6" placeholder="••••••" required
                           style="letter-spacing: 8px; font-size: 1.5rem;" />
                </div>

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <button type="submit" class="btn btn-primary w-100 btn-lg">
                    Verify & Continue to Ballot
                </button>
            </form>

            <div class="text-center mt-3">
                <a asp-action="RequestOtp">Resend Code</a>
            </div>
        </div>
    </div>
</div>
